[Unit]
Description=Nadree maintenance expiry (customer-free rentals require physical return)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/srv/nadree-api
ExecStart=/srv/nadree-api/.venv/bin/python -m app.jobs maintenance
TimeoutStartSec=5min
UMask=0077
