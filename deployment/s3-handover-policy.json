{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadAndInspectHandoverStaging",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_EXISTING_BUCKET/handover-upload-tmp/*"
    },
    {
      "Sid": "PublishAndReadHandoverMedia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_EXISTING_BUCKET/handover-media/*"
    }
  ]
}
