[Unit]
Description=Process saved Nadree administrator privacy requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/srv/nadree-api
ExecStart=/srv/nadree-api/.venv/bin/python -m app.account_deletion_jobs --apply
TimeoutStartSec=2h
UMask=0077
