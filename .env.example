# Separate service credentials. Never copy production values into this file.
NADREE_ENV=development
# Keep empty to start only health/docs without database access.
NADREE_DATABASE_URL=mysql://Datateam:RksEkQldi1@@www.riderlog-lte.com:50020/RIDERLOG_V2_DATA_TEST?charset=utf8mb4
NADREE_REDIS_URL=rediss://:nadreegogambyul9$@master.nadree-redis.cvkjol.apn2.cache.amazonaws.com:6379/0
# At least 32 random bytes. Required for authentication, not for /health/live.
NADREE_JWT_SECRET=nadree-jwt-access-secret-key-gambyul99
NADREE_JWT_ISSUER=nadree-api
NADREE_JWT_AUDIENCE=nadreego
NADREE_USER_JWT_AUDIENCE=nadri
NADREE_RENTAL_CURRENCY=USD
NADREE_BUSINESS_TIMEZONE=Asia/Makassar
# Vehicle-location Firebase configuration (separate from FCM).
# The current location adapter reads Firestore using this project and Google ADC.
NADREE_FIRESTORE_PROJECT=riderlog-new
# These Firebase Realtime Database/service-account values are kept in a separate
# location block for the location adapter. Never commit the private key.
NADREE_LOCATION_FIREBASE_CREDENTIAL_TYPE=service_account
NADREE_LOCATION_FIREBASE_PROJECT_ID=riderlog-new
NADREE_LOCATION_FIREBASE_PRIVATE_KEY_ID=<ROTATE_AND_SET_PRIVATE_KEY_ID>
NADREE_LOCATION_FIREBASE_PRIVATE_KEY=<ROTATE_AND_SET_PRIVATE_KEY_WITH_LITERAL_\\n>
NADREE_LOCATION_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-tlk6l@riderlog-new.iam.gserviceaccount.com
NADREE_LOCATION_FIREBASE_CLIENT_ID=109745537484801295759
NADREE_LOCATION_FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
NADREE_LOCATION_FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
NADREE_LOCATION_FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
NADREE_LOCATION_FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-tlk6l%40riderlog-new.iam.gserviceaccount.com
NADREE_LOCATION_FIREBASE_UNIVERSE_DOMAIN=googleapis.com
NADREE_LOCATION_FIREBASE_DATABASE_URL=https://riderlog-new-default-rtdb.asia-southeast1.firebasedatabase.app
# PayPal Sandbox credentials. Keep real values in a private environment file or
# AWS Secrets Manager; never commit Client Secret/Webhook ID to this sample.
NADREE_PAYPAL_ENVIRONMENT=SANDBOX
NADREE_PAYPAL_CLIENT_ID=<PAYPAL_SANDBOX_CLIENT_ID>
NADREE_PAYPAL_CLIENT_SECRET=<PAYPAL_SANDBOX_CLIENT_SECRET>
NADREE_PAYPAL_WEBHOOK_ID=<PAYPAL_SANDBOX_WEBHOOK_ID>
NADREE_PAYPAL_MERCHANT_ID=<PAYPAL_SANDBOX_MERCHANT_ID>
# FCM 발송 설정은 새 Firebase 프로젝트 연결 시 별도로 추가한다.
# Must match the shared database's existing Fernet key for encrypted phone writes.
NADREE_FIELD_ENCRYPT_KEY=
# Temporary-password email. Certificate verification is always enabled.
NADREE_SMTP_HOST=
NADREE_SMTP_PORT=587
NADREE_SMTP_USER=
NADREE_SMTP_PASSWORD=
NADREE_SMTP_FROM=
NADREE_SMTP_TLS=starttls
