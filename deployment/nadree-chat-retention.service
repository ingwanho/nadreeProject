[Unit]
Description=Delete Nadree chats 90 days after actual rental return
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/srv/nadree-api
ExecStart=/srv/nadree-api/.venv/bin/python -m app.chat_retention --apply
TimeoutStartSec=2h
UMask=0077
